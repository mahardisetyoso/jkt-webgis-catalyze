# Basemap — MapTiler (production). Get a free key at https://cloud.maptiler.com/account/keys/
# and restrict it to your domains (localhost + your *.vercel.app / custom domain).
# Leave empty to fall back to keyless OpenStreetMap raster tiles (dev/preview only).
NEXT_PUBLIC_MAPTILER_KEY=
# Optional MapTiler map id (default: dataviz-dark). e.g. streets-v2-dark, basic-v2-dark
NEXT_PUBLIC_MAPTILER_STYLE=dataviz-dark
